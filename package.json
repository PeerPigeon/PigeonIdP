{
  "name": "pigeonidp",
  "version": "1.0.0",
  "description": "P2P SAML identity provider using PeerPigeon 1.0.6 WebDHT and UnSEA",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/records.test.js && node test/test.js",
    "start": "node server.js"
  },
  "keywords": [
    "p2p",
    "identity",
    "authentication",
    "webdht",
    "peerpigeon",
    "idp",
    "saml",
    "unsea",
    "decentralized"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "unsea": "https://codeload.github.com/draeder/unsea/tar.gz/294cbf0fb1ae0dea4f43f533cfe02af4c3e361be"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeerPigeon/PigeonIdP"
  },
  "exports": {
    ".": "./index.js",
    "./records": "./records.js",
    "./relay": "./relay.js",
    "./saml": "./saml.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "records.js",
    "relay.js",
    "saml.js",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "peerpigeon": "*",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "peerDependenciesMeta": {
    "peerpigeon": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "cors": {
      "optional": true
    }
  }
}
